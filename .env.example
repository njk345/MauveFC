# Demo remains the default. Live mode fails closed if configuration is missing.
NEXT_PUBLIC_MAUVE_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=
# Public publishable/anon key only. Never put a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAUVE_CLUB_ID=
# Set only for the private Sites demo export; Vercel uses the default server build.
MAUVE_STATIC_EXPORT=false

# true only on static hosting, so newly created player profiles use a stable query route.
NEXT_PUBLIC_MAUVE_STATIC_HOST=false
